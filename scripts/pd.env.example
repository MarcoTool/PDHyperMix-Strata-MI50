# PD split settings: copy to pd.env and edit.  Every script reads this one file, so the two engines always get the
# same settings (the session fingerprint requires it: see docs/LESSONS.md#3).

# ---- build (pd_build.sh): both images come from this one checkout
STRATA_SRC=/opt/strata-src                 # a Strata checkout of the fork branch (see README)
CUDA_ARCHITECTURES="75;80;86;89;120"       # RTX 20/A/30/40/50; one arch (86 for a 3070) builds much faster
BUILD_JOBS=0                               # parallel compile jobs, 0 = half the cores; lower it if RAM is short

# ---- paths
DATA=/opt/strata-data                      # holds packs/ gguf/ mtp/ (mounted as /data in the containers)
WORK=/opt/pd                               # configs and logs

# ---- container images
IMG_PRE=pdhypermix-pre                     # docker/Dockerfile.cuda
IMG_DEC=pdhypermix-dec                     # docker/Dockerfile.gfx906
IMG_ROUTER=python:3.12-slim
DOCKER_ARGS=""                             # extra `docker run` flags for both engines, e.g. --cgroup-parent=...

# ---- model
PACK=/data/packs/iq3_s
SHARD1=/data/gguf/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf
SHARD2=/data/gguf/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf
MTP=/data/mtp/rt
PROFILE=/opt/strata/data/expert-profile.bin   # ships with Strata, inside both images

# ---- engine settings (identical on both engines)
MAX_CONTEXT=262144
KV_RESIDENT=262144                         # the whole KV in VRAM: 3.1 GiB at 262K, see docs/BENCHMARKS.md
SPEC=4
SPEC_MIN_P=0.5

# ---- RAM handoff
ARENA=/dev/shm/strata-experts.arena        # the one shared copy of the experts (~47 GiB for IQ3_S)
SLOTS=/dev/shm/pd-slots                    # session snapshots between the engines
SHM_SIZE=64G                               # tmpfs must hold ARENA + a snapshot + Strata's 4 GiB reserve
ARENA_GIB=47                               # for the RAM check before start
ENGINE_GIB=15                              # both engines' own memory, for the same check

# ---- ports
PORT_PRE=20061
PORT_DEC=20062
PORT_ROUTER=20030                          # what your clients talk to (OpenAI-compatible)
PD_MIN_CHARS=6000                          # new text from which a prompt goes to the prefill card (~2K tokens)

# ---- GPUs
PRE_GPU=0                                  # NVIDIA index of the prefill card
DEC_HIP_DEVICES=0,1                        # the MI50s
# gfx906 switches that the measurements used (the TOPK one needs the fork, see README)
DEC_ENV="-e STRATA_GFX906_TOPK_SPLIT=1 -e STRATA_GR_SPLIT=1 -e STRATA_GFX906_ATTN_QUERY_SWIZZLE=1 -e STRATA_GFX906_ATTN_REDUCE12=1"
